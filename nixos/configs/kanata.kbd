;;comment legend:
;;  '<->' = swapped
;;  '->'  = replaced (not swapped)

(defsrc
  caps lsft rsft lmet ralt del
  1 2 3 4 5 6 7 8 9 0
  \ ` [ ]
  q w e r t y u i o p
   a s d f g h j k l ; '
    z x c v b n m , . /
  left right up down
  home end pgup pgdn
  enter
  rctrl
)

(defalias
  ;;aliases that press shift and toggle number layer
  lshf_num (multi lsft (layer-toggle numbers))

  ;;super key
  sup (multi lmet (layer-toggle super-layer))

  rshf-mod (layer-toggle rshf-layer)

  del-layer-on (layer-switch del-layer)
  del-layer-off (layer-switch default)
  rshf-mod-rctrl  (layer-toggle rshf-ctrl-rctrl)
)

;;default layer
;; z <-> y ;;swapped
;; 1 <-> !
;; 2 <-> @
;; 3 <-> #
;; 4 <-> $
;; 5 <-> %
;; 6 <-> ^
;; 7 <-> &
;; 8 <-> *
;; 9 <-> (
;; 0 <-> )
;; [ <-> {
;; ] <-> }
;; \ <-> |
;; ` <-> ~
;; caps -> esc
;; right-shift -> custom modifier (layer)
;; super -> swaps number keys' (shift) layer
;; delete -> layer with navigation keys instead of symbols
(deflayer default

  ;;remap caps to esc and set shift and super keys to aliases
  esc @lshf_num @rshf-mod @sup lalt @del-layer-on

  ;;swap shift layer of top-row numbers
  S-1 S-2 S-3 S-4 S-5 S-6 S-7 S-8 S-9 S-0

  S-\ S-` S-[ S-]

  q w e r t z u i o p
   a s d f g h j k l ; '
    y x c v b n m , . /
  XX XX XX XX
  XX XX XX XX
  enter
  XX
)

;;super key layer (undoes some of the changes in default layer)
(deflayer super-layer
  _ _ _ (unmod lsft) _ _
  1 2 3 4 5 6 7 8 9 0
  _ _ _ _
  _ _ _ _ _ _ _ _ _ _
   _ _ _ _ _ _ _ _ _ _ _
    _ _ _ _ _ _ _ _ _ _
  _ _ _ _
  _ _ _ _
  _
  _
)

;;shift layer (undoes some of the changes in default layer)
(deflayer numbers
  _ _ _ _ _ _ ;;leave these untouched

  ;;use unmodified key signals for anything modified
  (unmod 1) (unmod 2) (unmod 3) (unmod 4) (unmod 5)
  (unmod 6) (unmod 7) (unmod 8) (unmod 9) (unmod 0)
  (unmod \) (unmod `) (unmod [) (unmod ])

  _ _ _ _ _ _ _ _ _ _
   _ _ _ _ _ _ _ _ _ _ _
    _ _ _ _ _ _ _ _ _ _
  _ _ _ _
  _ _ _ _
  _
  _
)

;;a custom modifier layer
;; w -> backspace
;; d -> delete
;; , -> home
;; l -> end
;; . -> left
;; / -> down
;; ; -> up
;; ' -> right
(deflayer rshf-layer
  _ _ _ _ _ XX

;;!  @  #  $  %  ^  &  *  (  )
  XX XX XX XX XX XX XX XX XX XX

;;|  ~  {    }
  XX XX pgup pgdn

;;q  w    e  r  t  z  u   i  o  p
  XX bspc XX XX XX XX XX XX XX XX

;;a  s  d   f  g  h  j  k  l   ;  '
  XX XX del XX XX XX XX XX end up right

;;y  x  c  v  b  n  m  ,    .    /
  XX XX XX XX XX XX XX home left down

  (movemouse-left 5 5)
  (movemouse-right 5 5)
  (movemouse-up 5 5)
  (movemouse-down 5 5)
  XX XX XX XX
  mlft
  @rshf-mod-rctrl
)

(deflayer rshf-ctrl-rctrl
  _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _
  _ _ _ _
  _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _

  (mwheel-left 50 120)
  (mwheel-right 50 120)
  (mwheel-up 50 120)
  (mwheel-down 50 120)
  XX XX XX mmid
  mrgt
  _
)

;;a layer that replaces symbols with navigation keys
;;  (intended for switch not button hold)
(deflayer del-layer
  esc lsft rsft lmet lalt @del-layer-off

  1 2 3 4 5 6 7 8 9 0

  XX XX XX XX

  q w e r t z u i o p
  a s d f g h j k l up right
  y x c v b n m XX left down

  XX XX XX XX
  home end pgup pgdn
  enter
  XX
)
